{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archies-appstore-lookup",
  "main": "workers/site.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "10k.aauburn.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "archies-appstore-lookup"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "containers": [
    {
      "class_name": "IconEmbed",
      "image": "registry.cloudflare.com/fd75e45889c3e4480b8ccee44f51156a/archies-appstore-lookup-iconembed@sha256:1b6c633c7c7083d8e491bf0f33ddf000896f0f2ae79dc5b1280e634b9dcf6e2d",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "d1_databases": [
    {
      "binding": "SITE_DB",
      "database_name": "site",
      "database_id": "245cac40-60d4-4831-8b0c-8f901de94ae2"
    },
    {
      "binding": "CATALOG_DB",
      "database_name": "catalog",
      "database_id": "44635e0b-2a36-4bbc-889b-1b2a5028895f"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "Presence"
      },
      {
        "name": "ICON_EMBED",
        "class_name": "IconEmbed"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Presence"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["IconEmbed"]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
