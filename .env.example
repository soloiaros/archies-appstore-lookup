# Copy to .env.local. Next loads .env.local. Nothing here is sent to the browser.

# OpenRouter key. Jev is POST /api/v1/systemone on openrouter.ai.
# TYPE_SAFE_KEY is read if this is unset.
OPENROUTER_API_KEY=

# Chart and lookup country. Default us.
ITUNES_COUNTRY=us

# One-time sponsor price in US cents. 150000 is $1,500 for 30 days.
SPONSOR_PRICE_CENTS=150000

# Sponsor orders email Wise details through Resend. Without a key, dev logs the mail.
RESEND_API_KEY=
SPONSOR_FROM_EMAIL=
SPONSOR_OWNER_EMAIL=

# Wise details sent to buyers. Use \n for line breaks.
WISE_PAYMENT_DETAILS=

# Key you type on /api/sponsor/confirm to put a paid card live.
SPONSOR_ADMIN_KEY=
