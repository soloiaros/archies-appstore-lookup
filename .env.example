# Copy to .env.local. Next loads .env.local. Nothing here is sent to the browser.

# OpenRouter key. Jev is POST /api/v1/systemone on openrouter.ai.
# TYPE_SAFE_KEY is read if this is unset.
OPENROUTER_API_KEY=

# Chart and lookup country. Default us.
ITUNES_COUNTRY=us

# One-time sponsor price in US cents. 250000 is $2,500 for 30 days.
SPONSOR_PRICE_CENTS=250000

# Stripe Checkout. Leave blank until payments should go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
