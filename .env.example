# Copy to .env.local. Next loads .env.local. Nothing here is sent to the browser.

# OpenRouter key. Jev is POST /api/v1/systemone on openrouter.ai.
# TYPE_SAFE_KEY is read if this is unset.
OPENROUTER_API_KEY=

# Chart and lookup country. Default us.
ITUNES_COUNTRY=us

# Better Auth. Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public site origin (no trailing slash). Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Extra origins, comma-separated (production already trusts https://10k.aauburn.com).
BETTER_AUTH_TRUSTED_ORIGINS=

# GitHub OAuth app → callback {BETTER_AUTH_URL}/api/auth/callback/github
# Enable Email addresses: Read-only if using a GitHub App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client → callback {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
